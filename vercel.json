{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/process-t3-cutoff",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/check-adventure-prep-cadence",
      "schedule": "7,22,37,52 * * * *"
    },
    {
      "path": "/api/trigger-deposit-holds",
      "schedule": "*/15 15,16,17,18 * * *"
    },
    {
      "path": "/api/check-hold-clearance-deadline",
      "schedule": "*/15 18,19,20,21 * * *"
    },
    {
      "path": "/api/send-deposit-hold-heads-up",
      "schedule": "*/15 14,15,16,17 * * *"
    },
    {
      "path": "/api/process-pending-kit-changes",
      "schedule": "10,25,40,55 * * * *"
    },
    {
      "path": "/api/renew-deposit-hold",
      "schedule": "*/15 19,20,21,22 * * *"
    },
    {
      "path": "/api/trigger-gear-reconciliation",
      "schedule": "3,18,33,48 * * * *"
    },
    {
      "path": "/api/sync-kit-subscribers",
      "schedule": "20 */4 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/after-the-trail-experience",
      "destination": "/peaks-to-pools",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/components/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
