# Copy to .env.local for local development (vercel dev). Never commit real
# keys — .env.local is gitignored. In production, set STRIPE_SECRET_KEY in
# the Vercel dashboard under Project -> Settings -> Environment Variables.

# Stripe secret key (server-side only, used by api/create-payment-intent.js).
# Use a sk_test_... key while testing, sk_live_... only once you're ready
# to take real payments.
STRIPE_SECRET_KEY=

# Stripe PUBLISHABLE key (safe to expose client-side — see
# api/stripe-config.js's header comment for why this isn't a secret).
# Served to adventure-form.js at runtime instead of being hardcoded there,
# so switching Stripe from test to live mode is this one env var change,
# matched to whichever mode STRIPE_SECRET_KEY above is in — pk_test_...
# with sk_test_..., pk_live_... with sk_live_..., never mixed.
STRIPE_PUBLISHABLE_KEY=

# Resend API key (server-side only, used by lib/send-booking-confirmation.js
# to send the booking confirmation email). Get this from the Resend
# dashboard once the mail.palmspringsadventureclub.com sending domain is
# verified. Scope the key to that domain only, sending access only, not
# full access (see the email/SMS infrastructure setup guide).
RESEND_API_KEY=

# Public HTTPS URL for the email header logo (psac-logo-email-header.png).
# Email clients can't load a local file, so this must point somewhere
# publicly hosted (the website's asset folder or a CDN).
BOOKING_CONFIRMATION_LOGO_URL=

# Twilio credentials (server-side only, used by lib/send-sms.js and
# lib/send-booking-confirmation-sms.js). Get these from the Twilio
# Console once A2P 10DLC is approved and a Messaging Service exists with
# your number/campaign attached (see the email/SMS infrastructure setup
# guide, Part B3). TWILIO_MESSAGING_SERVICE_SID is the pooled sender,
# not the raw phone number, it's how Twilio picks a sender and stays tied
# to the approved campaign.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Gear Inventory, Checkout & Deposit Reconciliation (Aug 2026). One shared
# secret across every new gear-ops endpoint in this build (check-gear-
# availability, allocate-gear-units, checkout-gear, check-in-gear-item,
# reconcile-gear-deposit, charge-gear-shortfall, refund-gear-charge,
# manage-gear-units, renew-deposit-hold's internal calls) — a deliberate
# deviation from this project's usual one-secret-per-endpoint convention,
# to keep this round's .env additions manageable. Split it into per-endpoint
# secrets later if that convention matters more than the convenience.
# Generate any long random string, e.g. `openssl rand -hex 32`.
GEAR_OPS_SHARED_SECRET=

# Vercel Blob — gear check-in damage/missing-item photos (lib/gear-photo-
# upload.js). NOT something to hand-generate: create a Blob store from the
# Vercel dashboard (Project -> Storage -> Blob) and attach it to this
# project; Vercel provisions this env var automatically on attach. Also
# run `npm install @vercel/blob` once against this repo (added to
# package.json's dependencies by this same patch, version unverified from
# this session — no network access to npm was attempted here).
BLOB_READ_WRITE_TOKEN=

# ============================================================
# Postgres / Neon (Relational Database Migration, Aug 2026)
# ============================================================
# Provisioned via Vercel's native Postgres integration (Project -> Storage
# -> Connect Database -> Postgres, powered by Neon) -- see the migration
# handoff doc for the exact click-path. Vercel wires this into every
# environment (production/preview/development) automatically once
# connected; for local development, copy the value it shows you into
# .env.local. Used by lib/db.js via @neondatabase/serverless's HTTP
# driver -- chosen over a traditional pg Pool specifically because it
# doesn't hold a long-lived TCP connection per invocation, which is what
# a real connection pool would exhaust under Vercel's per-invocation
# concurrency model.
DATABASE_URL=

# Kit (the homepage email-list tool) API key. Already used by the
# existing api/kit-subscribe.js homepage-signup endpoint (write direction:
# adds a new subscriber to Kit). The new Kit subscriber sync job (Section
# 4.1/Section 10 item 7 of the migration PRD -- read direction: syncs
# Kit's subscriber/tag state back into people.kit_subscriber_id /
# email_list_status) reuses this SAME key, never a second one.
KIT_API_KEY=
